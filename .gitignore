# Fichiers d'environnement (secrets et configurations locales)
.env
.env.local
.env.*.local

# Dépendances Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fichiers de build
dist/
build/
*.log
.next/
next-env.d.ts

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Fichiers temporaires
*.tmp
*.temp
nul
test-*.js
.playwright-mcp/

# Base de données locale (si vous avez des fichiers SQLite locaux)
*.db
*.sqlite
*.sqlite3
*.sql
backup_*.sql

# Cache Python (si vous avez des scripts Python)
__pycache__/
*.py[cod]
*$py.class

# IMPORTANT: On INCLUT le dossier .claude/ pour partager la configuration
# .claude/ est déjà tracké par défaut car on ne l'exclut pas
