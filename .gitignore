# Fichiers d'environnement (secrets et configurations locales)
# Tout .env* est ignoré par défaut ; seuls les templates sont explicitement inclus.
.env*
!.env.example
!.env.test.example

# Dépendances Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fichiers de build
dist/
build/
*.log
.next/
next-env.d.ts

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Fichiers temporaires
*.tmp
*.temp
nul
test-*.js
.playwright-mcp/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Base de données locale (si vous avez des fichiers SQLite locaux)
*.db
*.sqlite
*.sqlite3
*.sql
backup_*.sql
# Exception : les migrations Prisma doivent rester versionnées
!prisma/migrations/**/*.sql

# Cache Python (si vous avez des scripts Python)
__pycache__/
*.py[cod]
*$py.class

# IMPORTANT: On INCLUT le dossier .claude/ pour partager la configuration
# .claude/ est déjà tracké par défaut car on ne l'exclut pas

.vercel
.env*.local
server-logs.txt

# Git worktrees
.worktrees/
