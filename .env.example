# =============================================================================
# ERP Marchés Publics - Variables d'Environnement
# =============================================================================
#
# Instructions :
# 1. Copier ce fichier et le renommer en ".env"
# 2. Remplir toutes les valeurs vides
# 3. Ne JAMAIS commiter le fichier .env (il est dans .gitignore)
#
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL via Supabase)
# -----------------------------------------------------------------------------
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Exemple Supabase : postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Exemple local : postgresql://postgres:password@localhost:5432/erp_marches

DATABASE_URL=""

# -----------------------------------------------------------------------------
# SUPABASE (Base de données + Storage)
# -----------------------------------------------------------------------------
# Créer un projet sur https://supabase.com
# Les valeurs se trouvent dans : Settings > API

# URL publique du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=""

# Clé anonyme publique (safe pour le client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé service role (PRIVÉE - accès admin, ne pas exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# AUTHENTIFICATION (NextAuth.js v5)
# -----------------------------------------------------------------------------
# URL de l'application
# Production : https://votre-domaine.com
# Développement : http://localhost:3000

NEXTAUTH_URL="http://localhost:3000"

# Secret pour signer les tokens JWT
# Générer avec : openssl rand -base64 32
# OU : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NEXTAUTH_SECRET=""

# -----------------------------------------------------------------------------
# SMTP (Envoi d'emails pour les alertes)
# -----------------------------------------------------------------------------
# Exemples de serveurs SMTP :
# - Gmail : smtp.gmail.com (port 587, nécessite un mot de passe d'application)
# - Outlook : smtp-mail.outlook.com (port 587)
# - SendGrid : smtp.sendgrid.net (port 587)
# - Mailtrap (tests) : smtp.mailtrap.io (port 587)

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""

# Pour Gmail : créer un mot de passe d'application dans les paramètres Google
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=""

# Adresse email expéditeur (format : "Nom <email@domain.com>")
SMTP_FROM="ERP Marchés <noreply@erp-marches.com>"

# -----------------------------------------------------------------------------
# ALERTES
# -----------------------------------------------------------------------------
# Email du responsable qui recevra les alertes automatiques
# (cautions expirées, marchés en retard, etc.)

ALERT_EMAIL=""

# -----------------------------------------------------------------------------
# VERCEL CRON (Sécurité)
# -----------------------------------------------------------------------------
# Secret pour sécuriser les endpoints de tâches planifiées
# Générer un secret aléatoire : openssl rand -hex 32
# Utilisé pour vérifier que les requêtes viennent bien de Vercel Cron

CRON_SECRET=""

# -----------------------------------------------------------------------------
# DÉVELOPPEMENT (Optionnel)
# -----------------------------------------------------------------------------
# Activer les logs Prisma en développement
# Valeurs possibles : query,info,warn,error

# NODE_ENV="development"
# PRISMA_LOG_LEVEL="query,error,warn"
